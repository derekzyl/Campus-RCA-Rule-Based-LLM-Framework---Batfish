# LLM backend: ollama | openai | gemini | mock
LLM_BACKEND=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (online)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local — preferred for dissertation ethics)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=1800
OLLAMA_NUM_PREDICT=512

# Batfish (dual-core campus lab — see docs/topology/README.md)
BATFISH_HOST=localhost
BATFISH_PORT=9997
BATFISH_NETWORK=campus
USE_BATFISH=true

# Safety / dissertation settings
LLM_TEMPERATURE=0.0
ALLOW_REMEDIATION_APPLY=false
