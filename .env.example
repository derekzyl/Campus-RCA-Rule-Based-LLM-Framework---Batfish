# LLM backend: openai | ollama | mock
LLM_BACKEND=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
# Prefer llama3.1 for dissertation runs once pulled; llama3.2:3b is fine for quick tests.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=600

# Batfish
BATFISH_HOST=localhost
BATFISH_PORT=9997
BATFISH_NETWORK=campus
USE_BATFISH=true

# Safety / dissertation settings
LLM_TEMPERATURE=0.0
ALLOW_REMEDIATION_APPLY=false